# Catalog data source (see src/lib/catalog/README.md):
#   mock   - bundled JSON catalog in src/data (default)
#   medusa - Medusa Store API at NEXT_PUBLIC_MEDUSA_BACKEND_URL; needs the
#            publishable key below
CATALOG_DATA_SOURCE=mock

# Optional, medusa source only: pin the pricing region. When empty, the first
# region with INR currency is used, else the first region returned.
MEDUSA_REGION_ID=

# Public URL of the storefront (used for metadata and sitemap).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Commerce backend, used by the account area and future API-backed providers.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
